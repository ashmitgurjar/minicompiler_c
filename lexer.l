%option noyywrap
%option yylineno

%{
#include <cctype>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <vector>

#include "ast.hpp"
#include "parser.hpp" // generated by bison (CMake places in build dir)

// Track column for diagnostics.
int yycolumn = 1;

static void bump_col(int n) { yycolumn += n; }
%}

%%

[ \t\r]+          { bump_col(yyleng); }
\n                { yycolumn = 1; }

"int"             { bump_col(yyleng); return INT; }

"{"               { bump_col(1); return LBRACE; }
"}"               { bump_col(1); return RBRACE; }
"("               { bump_col(1); return LPAREN; }
")"               { bump_col(1); return RPAREN; }

";"               { bump_col(1); return SEMI; }
"="               { bump_col(1); return ASSIGN; }

"+"               { bump_col(1); return PLUS; }
"-"               { bump_col(1); return MINUS; }
"*"               { bump_col(1); return STAR; }
"/"               { bump_col(1); return SLASH; }

[0-9]+            {
                    yylval.ival = std::strtoll(yytext, nullptr, 10);
                    bump_col(yyleng);
                    return INT_LIT;
                  }

[a-zA-Z_][a-zA-Z0-9_]* {
                    yylval.sval = ::strdup(yytext);
                    bump_col(yyleng);
                    return IDENT;
                  }

"//".*            { bump_col(yyleng); }

.                 {
                    bump_col(yyleng);
                    return yytext[0];
                  }

%%

