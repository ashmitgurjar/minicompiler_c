%option noyywrap
%option yylineno

%{
#include <cctype>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <vector>
#include <string>

#include "ast.hpp"
#include "parser.hpp" // generated by bison (CMake places in build dir)

// Track column for diagnostics.
int yycolumn = 1;

static void bump_col(int n) { yycolumn += n; }

// Strips quotes and processes escape sequences
static char* clean_string(const char* text) {
  size_t len = strlen(text);
  if (len < 2) return ::strdup("");
  std::string result;
  result.reserve(len - 2);
  for (size_t i = 1; i < len - 1; ++i) {
    if (text[i] == '\\' && i + 1 < len - 1) {
      char next = text[i+1];
      if (next == 'n') result.push_back('\n');
      else if (next == 't') result.push_back('\t');
      else if (next == 'r') result.push_back('\r');
      else if (next == '\"') result.push_back('\"');
      else if (next == '\\') result.push_back('\\');
      else {
        result.push_back('\\');
        result.push_back(next);
      }
      ++i;
    } else {
      result.push_back(text[i]);
    }
  }
  return ::strdup(result.c_str());
}
%}

%%

[ \t\r]+                { bump_col(yyleng); }
\n                      { yycolumn = 1; }

"int"                   { bump_col(yyleng); return INT; }
"float"                 { bump_col(yyleng); return FLOAT; }
"bool"                  { bump_col(yyleng); return BOOL; }
"string"                { bump_col(yyleng); return STRING; }

"true"                  { bump_col(yyleng); return TRUE_LIT; }
"false"                 { bump_col(yyleng); return FALSE_LIT; }

"if"                    { bump_col(yyleng); return IF; }
"else"                  { bump_col(yyleng); return ELSE; }
"while"                 { bump_col(yyleng); return WHILE; }
"print"                 { bump_col(yyleng); return PRINT; }

"{"                     { bump_col(1); return LBRACE; }
"}"                     { bump_col(1); return RBRACE; }
"("                     { bump_col(1); return LPAREN; }
")"                     { bump_col(1); return RPAREN; }

";"                     { bump_col(1); return SEMI; }
"="                     { bump_col(1); return ASSIGN; }

"+"                     { bump_col(1); return PLUS; }
"-"                     { bump_col(1); return MINUS; }
"*"                     { bump_col(1); return STAR; }
"/"                     { bump_col(1); return SLASH; }

"=="                    { bump_col(2); return EQ; }
"!="                    { bump_col(2); return NE; }
"<="                    { bump_col(2); return LE; }
">="                    { bump_col(2); return GE; }
"<"                     { bump_col(1); return LT; }
">"                     { bump_col(1); return GT; }

"&&"                    { bump_col(2); return AND; }
"||"                    { bump_col(2); return OR; }
"!"                     { bump_col(1); return NOT; }

[0-9]+\.[0-9]+          {
                          yylval.fval = std::strtod(yytext, nullptr);
                          bump_col(yyleng);
                          return FLOAT_LIT;
                        }

[0-9]+                  {
                          yylval.ival = std::strtoll(yytext, nullptr, 10);
                          bump_col(yyleng);
                          return INT_LIT;
                        }

[a-zA-Z_][a-zA-Z0-9_]*  {
                          yylval.sval = ::strdup(yytext);
                          bump_col(yyleng);
                          return IDENT;
                        }

\"([^\\\"]|\\.)*\"      {
                          yylval.sval = clean_string(yytext);
                          bump_col(yyleng);
                          return STRING_LIT;
                        }

"//".*                  { bump_col(yyleng); }

.                       {
                          bump_col(yyleng);
                          return yytext[0];
                        }

%%
